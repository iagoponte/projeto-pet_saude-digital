{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "900px",
      "wideSize": "1320px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Verde principal",
          "color": "#176B52"
        },
        {
          "slug": "primary-dark",
          "name": "Verde escuro",
          "color": "#10533F"
        },
        {
          "slug": "secondary",
          "name": "Verde claro",
          "color": "#DDF3E8"
        },
        {
          "slug": "surface",
          "name": "Fundo suave",
          "color": "#F3F8F5"
        },
        {
          "slug": "text",
          "name": "Texto",
          "color": "#24332D"
        },
        {
          "slug": "muted",
          "name": "Texto secundário",
          "color": "#53635B"
        },
        {
          "slug": "background",
          "name": "Fundo",
          "color": "#FFFFFF"
        },
        {
          "slug": "border",
          "name": "Bordas",
          "color": "#DDE7E1"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Arial, Helvetica, sans-serif",
          "slug": "system",
          "name": "Sistema"
        }
      ]
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#24332D"
    },
    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "#24332D"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "link": {
        "color": {
          "text": "#176B52"
        }
      },
      "button": {
        "color": {
          "background": "#176B52",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  }
}
